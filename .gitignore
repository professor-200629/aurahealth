# Local session data (answers and report images). Never commit.
data/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Node / build output (rebuilt with: cd frontend; npm run build)
node_modules/
frontend/dist/
frontend/dist-web/

# Working file for scripts/build_prepared.py, so a stopped run can resume
EVAL_RESULTS/prepared_work.json

# Secrets, if any are ever added (use environment variables instead)
.env
*.key
